# =============================================================================
# MLFORGE ENVIRONMENT VARIABLES CONFIGURATION (APPENDIX A)
# =============================================================================

# Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# PostgreSQL Connection String (or sqlite:///./mlforge.db for local development)
DATABASE_URL=sqlite:///./mlforge.db

# Redis Connection String (Caching & Background Job Queue)
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication Security
JWT_SECRET_KEY=mlforge_dev_secret_key_change_in_production_2026
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Model Registry & Object Storage
MODEL_STORAGE_PATH=./models
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# Experiment Tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# Security & CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_DEFAULT=60

# Observability
PROMETHEUS_METRICS_PATH=/api/metrics/system
SENTRY_DSN=
